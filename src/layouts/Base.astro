---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  published?: Date;
}
const {
  title,
  description = "A vAdmin's journey into the world of DevOps & Automation.",
  article = false,
  published,
} = Astro.props;
const pageTitle = title
  ? `${title} | SimplyGeek`
  : "SimplyGeek | DevOps & Automation";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="SimplyGeek"
      href="/feed.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    {published && (
      <meta
        property="article:published_time"
        content={published.toISOString()}
      />
    )}
    <meta name="theme-color" content="#202224" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("simplygeek-theme") === "light"
            ? "light"
            : "dark";
      } catch {}
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="brand" href="/" aria-label="SimplyGeek home">
          <svg class="brand-prompt" viewBox="0 0 44 36" aria-hidden="true" focusable="false">
            <path d="M3 6 19 17 3 28M25 29h16" fill="none" stroke="currentColor" stroke-width="5" />
          </svg>
          <span class="brand-wordmark" aria-hidden="true">Simply<span>Geek</span></span>
        </a>
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="site-navigation"
          aria-label="Open menu"
          hidden
        >
          <span aria-hidden="true">&#9776;</span>
        </button>
        <nav id="site-navigation" aria-label="Main navigation">
          <details class="topic-menu">
            <summary>
              VMware Cloud Foundation <span aria-hidden="true">&#8964;</span>
            </summary>
            <div class="submenu">
              <a href="/vmware-aria/">VMware Cloud Foundation overview</a>
              <a href="/aria-automation/">VCF Automation</a>
              <a href="/aria-automation-orchestrator/">
                VCF Operations Orchestrator
              </a>
              <a
                class="subtopic"
                href="/vcf-operations-orchestrator-auto-document-your-actions-with-ease/"
              >
                Auto-document your actions
              </a>
              <a
                class="subtopic"
                href="/how-i-write-beautiful-code-in-vcf-operations-orchestrator-using-eslint-and-prettier/"
              >
                Code style with ESLint & Prettier
              </a>
              <a href="/build-tools-for-vmware-aria/">
                Build Tools for VMware Aria
              </a>
              <a href="/nsx/">VMware NSX</a>
            </div>
          </details>
          <a href="/ansible/">Ansible</a>
          <a
            href="/about/"
            aria-current={Astro.url.pathname === "/about/" ? "page" : undefined}
          >
            About
          </a>
        </nav>
        <div class="header-tools">
          <button
            class="theme-toggle"
            aria-label="Use light theme"
            aria-pressed="false"
            hidden
          >
            <span aria-hidden="true">&#9728;</span>
            <span class="toggle-track" aria-hidden="true"></span>
          </button>
          <a
            class="search-link"
            href="/archive/#search"
            aria-label="Search articles"
          >
            <svg
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="7" />
              <path d="m15 15 6 6" />
            </svg>
          </a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>SimplyGeek &copy; {new Date().getFullYear()}. All Rights Reserved.</p>
      <div class="footer-links">
        <a href="/archive/">Archive</a>
        <a href="/sitemap/">Site map</a>
        <a href="/feed.xml">RSS</a>
        <a href="https://github.com/simplygeekuk">GitHub</a>
      </div>
      <a class="back-to-top" href="#top" aria-label="Back to top">
        &#8963;
      </a>
    </footer>
    <script>
      const themeButton =
        document.querySelector<HTMLButtonElement>(".theme-toggle");
      function syncThemeButton() {
        const light = document.documentElement.dataset.theme === "light";
        themeButton?.setAttribute("aria-pressed", String(light));
        themeButton?.setAttribute(
          "aria-label",
          light ? "Use dark theme" : "Use light theme",
        );
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", light ? "#f1f5f7" : "#202224");
      }
      if (themeButton) {
        themeButton.hidden = false;
        syncThemeButton();
        themeButton.addEventListener("click", () => {
          const theme =
            document.documentElement.dataset.theme === "light"
              ? "dark"
              : "light";
          document.documentElement.dataset.theme = theme;
          try {
            localStorage.setItem("simplygeek-theme", theme);
          } catch {}
          syncThemeButton();
        });
      }
      const menuButton =
        document.querySelector<HTMLButtonElement>(".menu-toggle");
      const navigation =
        document.querySelector<HTMLElement>("#site-navigation");
      if (menuButton && navigation) {
        menuButton.hidden = false;
        navigation.dataset.collapsible = "true";
        menuButton.addEventListener("click", () => {
          const open = menuButton.getAttribute("aria-expanded") !== "true";
          menuButton.setAttribute("aria-expanded", String(open));
          menuButton.setAttribute(
            "aria-label",
            open ? "Close menu" : "Open menu",
          );
          navigation.classList.toggle("is-open", open);
        });
      }
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const topic =
          document.querySelector<HTMLDetailsElement>(".topic-menu[open]");
        if (topic) {
          topic.open = false;
          topic.querySelector("summary")?.focus();
        } else if (menuButton?.getAttribute("aria-expanded") === "true") {
          menuButton.click();
          menuButton.focus();
        }
      });
    </script>
  </body>
</html>
