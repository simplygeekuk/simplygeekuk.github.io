---
import BlogPage from "../../components/BlogPage.astro";
import { articles, POSTS_PER_PAGE } from "../../lib/content";

export async function getStaticPaths() {
  const posts = (await articles()).filter(({ data }) => data.kind === "post");
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { allPosts: posts, currentPage: index + 2 },
  }));
}
const { allPosts, currentPage } = Astro.props;
---

<BlogPage allPosts={allPosts} currentPage={currentPage} />
