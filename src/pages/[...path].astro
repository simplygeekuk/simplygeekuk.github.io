---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import FeaturedPosts from "../components/FeaturedPosts.astro";
import YearlyPosts from "../components/YearlyPosts.astro";
import TableOfContents from "../components/TableOfContents.astro";
import SeriesNavigation from "../components/SeriesNavigation.astro";
import Comments from "../components/Comments.astro";
import BackToTop from "../components/BackToTop.astro";
import { articles, formatDate } from "../lib/content";
import { archives, allArchives, archivePosts, topicArchive, topicPosts } from "../lib/archives";
import { articleSeries, relatedArticles } from "../lib/series";
import comments from "../data/comments.json";
import articleImages from "../data/article-images.json";

export async function getStaticPaths() {
  const entries = await articles();
  const resolvedArchives = allArchives(entries);
  const paths = new Set(entries.map((entry) => entry.data.path));
  for (const archive of resolvedArchives) {
    if (paths.has(archive.path))
      throw new Error(`Duplicate archive path: ${archive.path}`);
    paths.add(archive.path);
  }
  return [
    ...entries.map((entry) => ({
      params: { path: entry.data.path.replace(/^\/|\/$/g, "") },
      props: { entry, archive: null },
    })),
    ...resolvedArchives.map((archive) => ({
      params: { path: archive.path.replace(/^\/|\/$/g, "") },
      props: { entry: null, archive },
    })),
  ];
}
const { entry, archive } = Astro.props;
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const showGeneratedContents = entry?.data.toc && !entry.data.wordpressId;
const isPost = entry?.data.kind === "post";
const imageCredit = articleImages.find((image) => image.featuredImage === entry?.data.featuredImage);
const entries = await articles();
const series = isPost ? articleSeries(entries).find((group) => group.posts.some((post) => post.id === entry.id)) : undefined;
const suggestions = isPost ? relatedArticles(entry, entries) : [];
const topic = archive ?? (entry ? topicArchive(entry.data.path) : undefined);
const related = topic ? archivePosts(topic, entries) : [];
const topicArticles = entry?.data.kind === "page" ? topicPosts(entry.data.path, entries) : undefined;
const title = entry?.data.title ?? archive?.title ?? "Archive";
const description =
  (entry?.data.description ?? archive?.description) ||
  `${title} articles and guides from SimplyGeek.`;
const discussion = entry
  ? comments.filter((comment) => comment.post === entry.data.wordpressId)
  : [];
---

<Base
  title={title}
  description={description}
  article={isPost}
  published={isPost ? entry?.data.published : undefined}
>
  {archive ? (
    <section class="archive wrap">
      <a class="back-link" href="/archive/">
        &larr; All articles
      </a>
      <p class="eyebrow">
        {archive.kind === "series"
          ? "Article series"
          : archive.kind === "tag"
            ? "Tag"
            : "Topic"}
      </p>
      <h1>{title}</h1>
      {archive.description && <p>{archive.description}</p>}
      {related.length ? (
        related.map((post) => <PostCard post={post} />)
      ) : (
        <p>
          No articles are currently published in this topic.{" "}
          <a href="/archive/">Browse all articles.</a>
        </p>
      )}
    </section>
  ) : topicArticles !== undefined ? (
    <div class="home wrap">
      <a class="back-link" href="/">&larr; Back to the blog</a>
      <header class="home-intro">
        <div>
          <h1>{title}</h1>
          <p>{description}</p>
        </div>
      </header>
      {Content && <div class="prose"><Content /></div>}
      {topicArticles.length ? (
        <>
          {topic?.kind !== "series" && <FeaturedPosts posts={topicArticles} />}
          <section aria-label="Articles in this topic">
            <YearlyPosts posts={topicArticles} groupByYear={topic?.kind !== "series"} />
          </section>
        </>
      ) : (
        <p>No articles are currently published in this topic. <a href="/archive/">Browse all articles.</a></p>
      )}
    </div>
  ) : (
    entry && (
      <article class="article wrap">
        <header class="article-header">
          <a class="back-link" href="/">
            &larr; Back to the blog
          </a>
          <p class="eyebrow">
            {isPost
              ? (entry.data.categories.at(-1) ?? "Article")
              : topic
                ? "Explore a topic"
                : "Behind the blog"}
          </p>
          <h1>{title}</h1>
          {isPost && (
            <p class="article-meta">
              <time datetime={entry.data.published.toISOString()}>
                {formatDate(entry.data.published)}
              </time>
              <span> / </span>
              {entry.data.author}
            </p>
          )}
        </header>
        {isPost && entry.data.featuredImage && (
          <figure class="article-featured">
          <img
            class="article-featured-image"
            src={entry.data.featuredImage}
            alt={imageCredit?.alt ?? ""}
            decoding="async"
            fetchpriority="high"
          />
          {imageCredit && (
            <figcaption>
              Photo: <a href={imageCredit.source}>{imageCredit.photographer} / Pexels</a>
              {" · "}<a href={imageCredit.licenseUrl}>Licence</a>
            </figcaption>
          )}
          </figure>
        )}
        <div class="prose">
          {showGeneratedContents && <TableOfContents headings={rendered?.headings ?? []} />}
          {Content && <Content />}
        </div>
        {series && <SeriesNavigation title={series.title} path={series.path} posts={series.posts} currentPath={entry.data.path} />}
        {suggestions.length > 0 && (
          <section class="related-articles" aria-labelledby="related-articles-title">
            <h2 id="related-articles-title">Related articles</h2>
            {suggestions.map((post) => <PostCard post={post} />)}
          </section>
        )}
        {isPost && entry.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="Article tags">
            {entry.data.tags.map((tag) => {
              const archive = archives.find(
                (archive) =>
                  archive.kind === "tag" &&
                  archive.title === tag &&
                  archive.postIds.includes(entry.data.wordpressId ?? -1),
              );
              return (
                <li>{archive ? <a href={archive.path}>{tag}</a> : tag}</li>
              );
            })}
          </ul>
        )}
        {discussion.length > 0 && (
          <section
            class="discussion"
            id="comments"
            aria-labelledby="discussion-title"
          >
            <h2 id="discussion-title">
              Archived comments <span>({discussion.length})</span>
            </h2>
            <p class="discussion-note">
              Comments from the original blog, preserved for reference.
            </p>
            <ol class="comment-list">
              {discussion.map((comment) => (
                <li class="comment" id={`comment-${comment.id}`}>
                  <header>
                    <strong>{comment.author}</strong>
                    <a href={`#comment-${comment.id}`}>
                      <time datetime={comment.date}>
                        {formatDate(new Date(comment.date))}
                      </time>
                    </a>
                  </header>
                  {comment.parent > 0 && (
                    <a
                      class="comment-parent"
                      href={`#comment-${comment.parent}`}
                    >
                      Reply to{" "}
                      {discussion.find((parent) => parent.id === comment.parent)
                        ?.author ?? "earlier comment"}
                    </a>
                  )}
                  <div class="prose" set:html={comment.html} />
                </li>
              ))}
            </ol>
          </section>
        )}
        {isPost && <Comments hasArchivedComments={discussion.length > 0} />}
        <div class="article-end">
          <a href="/archive/">&larr; Explore more articles</a>
          <a href="/feed.xml">Follow via RSS &nearr;</a>
        </div>
      </article>
    )
  )}
  {isPost && <BackToTop />}
</Base>
