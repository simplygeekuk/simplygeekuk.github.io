---
import Base from "../layouts/Base.astro";
import FeaturedPosts from "./FeaturedPosts.astro";
import YearlyPosts from "./YearlyPosts.astro";
import type { CollectionEntry } from "astro:content";
import { POSTS_PER_PAGE } from "../lib/content";
interface Props {
  allPosts: CollectionEntry<"articles">[];
  currentPage?: number;
}
const { allPosts, currentPage = 1 } = Astro.props;
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice((currentPage - 1) * POSTS_PER_PAGE, currentPage * POSTS_PER_PAGE);
const previousPage = currentPage === 2 ? "/" : `/page/${currentPage - 1}/`;
---

<Base title={currentPage > 1 ? `Articles - Page ${currentPage}` : undefined}>
  <div class="home wrap">
    <header class="home-intro">
      <div>
        <h1>DevOps &amp; Automation</h1>
        <p>Practical guides and lessons from the field.</p>
      </div>
      <a href="/feed.xml">
        Follow via RSS <span aria-hidden="true">&nearr;</span>
      </a>
    </header>
    {currentPage === 1 && <FeaturedPosts posts={allPosts} />}
    <section aria-label="Latest articles">
      <YearlyPosts posts={posts} />
      {totalPages > 1 && (
        <nav class="archive-link pagination" aria-label="Article pages">
          {currentPage > 1 && <a href={previousPage} rel="prev"><span aria-hidden="true">&larr;</span> Previous</a>}
          <span class="page-number">Page {currentPage} of {totalPages}</span>
          {currentPage < totalPages && <a href={`/page/${currentPage + 1}/`} rel="next">Next <span aria-hidden="true">&rarr;</span></a>}
        </nav>
      )}
    </section>
  </div>
</Base>
